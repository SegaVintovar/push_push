#include "push_push_header.h"

// pure AI
int	get_chunk_size(size_t stack_size)
{
	if (stack_size <= 100)
		return (stack_size / 4);      // ~25 per chunk
    else if (stack_size <= 500)
		return (stack_size / 8);      // ~62 per chunk
	else
		return (stack_size / 10);     // ~50 per chunk
}

void	init_chunk(t_chunk_info *chunk, size_t stack_size)
{
	chunk->chunk_size = get_chunk_size(stack_size);
	chunk->chunk_start = 0;
	chunk->chunk_end = chunk->chunk_size;
}

void	next_chunk(t_chunk_info *chunk)
{
	chunk->chunk_start = chunk->chunk_end;
	chunk->chunk_end += chunk->chunk_size;
}

void push_to_b_in_chunks(t_stack *a, t_stack *b, t_chunk_info *chunk)
{
    int max_index_to_push = a->size - chunk->chunk_size;
    
    while (a->size > chunk->chunk_size)
    {
        int top = a->arr[0];
        
        // If top is in current chunk range, push it
        if (top >= chunk->chunk_start && top < chunk->chunk_end)
        {
            int should_rotate = (top < chunk->chunk_start + (chunk->chunk_size / 2));
            pb(a, b);
            if (should_rotate && b->size > 1)
                rb(b);
        }
        // If top is >= all chunks we want to push, just rotate
        else if (top >= max_index_to_push)
        {
            ra(a);
        }
        // If top is beyond current chunk, advance to next
        else if (top >= chunk->chunk_end)
        {
            next_chunk(chunk);
        }
        // If top is before current chunk, rotate
        else
        {
            ra(a);
        }
    }
}

// Find where b_val should be inserted in A
// Returns the index where b_val should go
int find_target_position(t_stack *a, int b_val)
{
    size_t i;
    int max_val;
    int max_idx;
    
    max_val = a->arr[0];
    max_idx = 0;
    
    // Find max element
    for (i = 0; i < a->size; i++)
    {
        if (a->arr[i] > max_val)
        {
            max_val = a->arr[i];
            max_idx = i;
        }
    }
    
    // Find where b_val should go
    for (i = 0; i < a->size; i++)
    {
        // Check if b_val fits between current and next element
        if (a->arr[i] < b_val)
        {
            // If next element exists and is greater, insert here
            if (i + 1 < a->size && a->arr[i + 1] > b_val)
                return (i + 1);
        }
    }
    
    // b_val is greater than max, goes after max
    return ((max_idx + 1) % a->size);
}

// Calculate all 4 possible move combinations
t_move_cost calculate_move_cost(t_stack *a, t_stack *b, 
                                 int b_idx, int target_in_a)
{
    t_move_cost cost;
    int ra_cost, rra_cost, rb_cost, rrb_cost;
    
    // Cost to bring target to top of A
    ra_cost = target_in_a;
    rra_cost = a->size - target_in_a;
    
    // Cost to bring b_val to top of B
    rb_cost = b_idx;
    rrb_cost = b->size - b_idx;
    
    // Option 1: Both rotate up (using rr)
    cost.ra_count = ra_cost;
    cost.rb_count = rb_cost;
    cost.rra_count = 0;
    cost.rrb_count = 0;
    int cost1 = ra_cost + rb_cost;  // rr does max(ra, rb), then single rotates
    
    // Option 2: Both rotate down (using rrr)
    int cost2 = rra_cost + rrb_cost;
    
    // Option 3: A up, B down
    int cost3 = ra_cost + rrb_cost;
    
    // Option 4: A down, B up
    int cost4 = rra_cost + rb_cost;
    
    // Pick cheapest and store the move plan
    cost.total_cost = cost1;
    cost.ra_count = ra_cost;
    cost.rb_count = rb_cost;
    cost.rra_count = 0;
    cost.rrb_count = 0;
    
    if (cost2 < cost.total_cost)
    {
        cost.total_cost = cost2;
        cost.ra_count = 0;
        cost.rb_count = 0;
        cost.rra_count = rra_cost;
        cost.rrb_count = rrb_cost;
    }
    if (cost3 < cost.total_cost)
    {
        cost.total_cost = cost3;
        cost.ra_count = ra_cost;
        cost.rb_count = 0;
        cost.rra_count = 0;
        cost.rrb_count = rrb_cost;
    }
    if (cost4 < cost.total_cost)
    {
        cost.total_cost = cost4;
        cost.ra_count = 0;
        cost.rb_count = rb_cost;
        cost.rra_count = rra_cost;
        cost.rrb_count = 0;
    }
    return (cost);
}

t_cheapest find_cheapest_in_b(t_stack *a, t_stack *b)
{
    t_cheapest cheapest;
    t_move_cost current_cost;
    size_t i;
    int target_pos;
    
    cheapest.cost.total_cost = INT_MAX;
    cheapest.b_idx = 0;
    
    // Try each element in B
    for (i = 0; i < b->size; i++)
    {
        target_pos = find_target_position(a, b->arr[i]);
        current_cost = calculate_move_cost(a, b, i, target_pos);
        
        if (current_cost.total_cost < cheapest.cost.total_cost)
        {
            cheapest.b_idx = i;
            cheapest.cost = current_cost;
        }
    }
    
    return (cheapest);
}

void execute_move_plan(t_stack *a, t_stack *b, t_move_cost cost)
{
    // Rotate A up
    while (cost.ra_count > 0)
    {
        ra(a);
        cost.ra_count--;
    }
    
    // Rotate A down
    while (cost.rra_count > 0)
    {
        rra(a);
        cost.rra_count--;
    }
    
    // Rotate B up
    while (cost.rb_count > 0)
    {
        rb(b);
        cost.rb_count--;
    }
    
    // Rotate B down
    while (cost.rrb_count > 0)
    {
        rrb(b);
        cost.rrb_count--;
    }
    
    // Push element from B to A
    pa(a, b);
}

// Rotate A until smallest element (0) is on top
void rotate_until_sorted(t_stack *a)
{
    size_t i;
    
    if (a->size == 0)
        return;
    
    // Find position of 0
    for (i = 0; i < a->size; i++)
    {
        if (a->arr[i] == 0)
            break;
    }
    
    // Rotate until 0 is on top
    while (a->arr[0] != 0 && i < a->size)
    {
        ra(a);
    }
}

void rebuild_stack(t_stack *a, t_stack *b)
{
    t_cheapest cheapest;
    
    // While B is not empty
    while (b->size > 0)
    {
        // Find the cheapest element to move
        cheapest = find_cheapest_in_b(a, b);
        
        // Execute the move plan
        execute_move_plan(a, b, cheapest.cost);
    }
    
    // Final step: rotate A so index 0 is on top
    rotate_until_sorted(a);
}


//end of the pure AI