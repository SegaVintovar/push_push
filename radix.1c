int count_bits(size_t stack_size)
{
	int	i;
	int	bits_amount;
	
	bits_amount = 1;
	i = 0;
	while (i < 64)
	{
		if (stack_size >> i & 1)
			bits_amount = i;
		i++;
	}
	bits_amount++;
	return (bits_amount);
}

void	radix_s(t_stack *a, t_stack *b)
{
	int	bits_amnt;
	int	i;
	size_t	p;
	
	i = 0;
	bits_amnt = count_bits(a->size);
	convert_into_indices(a);
	
	while (is_sorted(a) == 0 && i < bits_amnt)
	{
		p = 0;
		while (p < a->size)
		{
			if (a->arr[0] >> i & 1)
				ra(a);
			else
				pb(a, b);
			p++;
		}
		while (b->size > 0)
			pa(a, b);
	}
}


